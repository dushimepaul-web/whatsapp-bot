    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.6.0",
    "pino": "^9.7.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.7.5",
    "uuid": "^14.0.1"
  },
  "devDependencies": {
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.4.2",
    "nodemon": "^3.0.1",
    "pino-pretty": "^13.1.1",
    "prettier": "^3.9.5",
    "supertest": "^7.2.2"
  }
