  "version": "1.0.0",
  "description": "SaaS WhatsApp Management Platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "pm2": "pm2 start pm2.config.js",
    "lint": "eslint . --ignore-pattern node_modules/ --ignore-pattern auth_info/ --ignore-pattern media_cache/",
    "lint:fix": "eslint . --fix --ignore-pattern node_modules/ --ignore-pattern auth_info/ --ignore-pattern media_cache/",
    "format": "prettier --write '**/*.js' --ignore-path .eslintignore",
    "test": "jest --forceExit --detectOpenHandles"
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "bcryptjs": "^2.4.3",
